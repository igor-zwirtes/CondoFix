@startuml
left to right direction

skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor white
    BorderColor #333333
}

skinparam usecase {
    BackgroundColor #FDFDFD
    BorderColor #333333
}

skinparam rectangle {
    BackgroundColor white
    BorderColor #333333
}


' ATORES

actor "Usuário" as Usuario
actor "Morador" as Morador
actor "Administrador" as Admin
actor "Prestador de Serviço" as Prestador

Morador --|> Usuario
Admin --|> Usuario
Prestador --|> Usuario


' SISTEMA

rectangle "Sistema de Gestão de Manutenção" {

    ' ---------- AUTENTICAÇÃO ----------

    usecase "Realizar login" as UC01
    usecase "Recuperar senha" as UC02


    ' ---------- SOLICITAÇÕES ----------

    usecase "Criar solicitação" as UC05
    usecase "Consultar solicitações" as UC06
    usecase "Definir prioridade" as UC07
    usecase "Atribuir responsável" as UC08


    ' ---------- EXECUÇÃO ----------

    usecase "Consultar serviço\natribuído" as UC09
    usecase "Atualizar status" as UC10
    usecase "Adicionar observação" as UC11
    usecase "Registrar conclusão" as UC12
    usecase "Encerrar solicitação" as UC13


    ' ---------- ACOMPANHAMENTO ----------

    usecase "Acompanhar solicitação" as UC14
    usecase "Consultar histórico" as UC15
    usecase "Consultar histórico\nde alterações" as UC16


    ' ---------- AVALIAÇÃO ----------

    usecase "Avaliar serviço" as UC17


    ' ---------- ADMINISTRAÇÃO ----------

    usecase "Cadastrar usuário" as UC03
    usecase "Gerenciar usuários" as UC04
    usecase "Visualizar dashboard" as UC18
}


' ORGANIZAÇÃO VISUAL

' Linha principal do fluxo

UC01 -[hidden]down- UC05
UC05 -[hidden]down- UC06
UC06 -[hidden]down- UC07
UC07 -[hidden]down- UC08
UC08 -[hidden]down- UC09
UC09 -[hidden]down- UC10
UC10 -[hidden]down- UC11
UC11 -[hidden]down- UC12
UC12 -[hidden]down- UC13
UC13 -[hidden]down- UC14
UC14 -[hidden]down- UC15
UC15 -[hidden]down- UC16
UC16 -[hidden]down- UC17

' Administração em uma coluna lateral

UC03 -[hidden]right- UC07
UC04 -[hidden]right- UC08
UC18 -[hidden]right- UC16


' ASSOCIAÇÕES

' Usuário
Usuario --> UC01
Usuario --> UC02

' Morador
Morador --> UC05
Morador --> UC06
Morador --> UC14
Morador --> UC15
Morador --> UC17

' Administrador
Admin --> UC03
Admin --> UC04
Admin --> UC06
Admin --> UC07
Admin --> UC08
Admin --> UC11
Admin --> UC15
Admin --> UC16
Admin --> UC18

' Prestador
Prestador --> UC06
Prestador --> UC09
Prestador --> UC10
Prestador --> UC11
Prestador --> UC12
Prestador --> UC13


' INCLUDE

UC12 ..> UC10 : <<include>>
UC13 ..> UC12 : <<include>>
UC14 ..> UC06 : <<include>>


' EXTEND

UC17 ..> UC13 : <<extend>>
UC02 ..> UC01 : <<extend>>

@enduml