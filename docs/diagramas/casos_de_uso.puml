
@startuml
left to right direction

skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor white
    BorderColor #333333
}

skinparam usecase {
    BackgroundColor #FDFDFD
    BorderColor #333333
}

skinparam rectangle {
    BackgroundColor white
    BorderColor #333333
}

' ATORES

actor "Usuário" as Usuario
actor "Morador" as Morador
actor "Síndico" as Sindico
actor "Administrador do\nSistema" as Admin
actor "Prestador de Serviço" as Prestador

Morador --|> Usuario
Sindico --|> Usuario
Admin --|> Usuario
Prestador --|> Usuario


' SISTEMA

rectangle "CondoFix - Sistema de Gestão de Manutenção" {

    package "Autenticação" {
        usecase "Realizar login" as UC01
    }

    package "Gerenciamento de usuários" {
        usecase "Consultar usuários" as UC02
        usecase "Cadastrar usuário" as UC03
        usecase "Editar usuário" as UC04
        usecase "Desativar usuário" as UC05
    }

    package "Gestão de solicitações" {
        usecase "Criar solicitação" as UC06
        usecase "Consultar próprias\nsolicitações" as UC07
        usecase "Consultar solicitações\ndo condomínio" as UC08
        usecase "Consultar detalhes\nda solicitação" as UC09
        usecase "Aprovar solicitação" as UC10
        usecase "Atribuir prestador" as UC11
        usecase "Cancelar solicitação" as UC12
        usecase "Reabrir solicitação" as UC13
    }

    package "Execução dos serviços" {
        usecase "Consultar serviços\natribuídos" as UC14
        usecase "Atualizar status\ndo serviço" as UC15
        usecase "Registrar conclusão\ndo serviço" as UC16
    }

    package "Acompanhamento e avaliação" {
        usecase "Consultar histórico\nde alterações" as UC17
        usecase "Aceitar conclusão\ne avaliar serviço" as UC18
    }

    package "Faturamento e indicadores" {
        usecase "Consultar faturamento" as UC19
        usecase "Finalizar solicitação\nfaturada" as UC20
        usecase "Visualizar dashboard" as UC21
    }
}


' AUTENTICAÇÃO

Usuario --> UC01


' ADMINISTRADOR DO SISTEMA

Admin --> UC02
Admin --> UC03
Admin --> UC04
Admin --> UC05


' SÍNDICO

Sindico --> UC08
Sindico --> UC09
Sindico --> UC10
Sindico --> UC11
Sindico --> UC12
Sindico --> UC13
Sindico --> UC17
Sindico --> UC19
Sindico --> UC20
Sindico --> UC21


' MORADOR

Morador --> UC06
Morador --> UC07
Morador --> UC09
Morador --> UC12
Morador --> UC13
Morador --> UC17
Morador --> UC18


' PRESTADOR DE SERVIÇO

Prestador --> UC14
Prestador --> UC09
Prestador --> UC15
Prestador --> UC16
Prestador --> UC17


' RELACIONAMENTOS ENTRE CASOS DE USO

UC14 ..> UC09 : <<include>>
UC16 ..> UC15 : <<include>>

note right of UC12
  Permitido somente para solicitações
  nos estados Aberta ou Atribuida.
  O morador só pode cancelar
  suas próprias solicitações.
end note

note right of UC13
  Permitido somente para solicitações
  Concluidas.
  O morador só pode reabrir
  suas próprias solicitações.
end note

note right of UC15
  O prestador atualiza o status
  de Atribuida para Em andamento
  e depois para Concluida.
end note

note right of UC18
  Disponível após a conclusão
  do serviço pelo prestador.
end note

note right of UC20
  O síndico finaliza a solicitação
  após o registro do faturamento.
end note

@enduml